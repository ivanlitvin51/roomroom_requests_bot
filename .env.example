# Токен Telegram-бота (от @BotFather)
TOKEN=your_telegram_bot_token_here

# Секретный ключ для авторизации модераторов в боте
SECRET_KEY=your_secret_key_here

# Пути к файлам хранения данных
MODERS_FILE=moders.json
LAST_ID_FILE=data/last_id.txt
LAST_CHAT_ID_FILE=data/last_chat_id.txt

# Токен администратора бэкенда для Bearer-авторизации
ADMIN_TOKEN=your_backend_admin_jwt_token_here

# Эндпоинты API
API_URL_REQUESTS=https://room-room.app/api/requests/expert-connection?page=1&pageSize=10
API_URL_CHATS=https://room-room.app/api/messenger/chats?page=1&pageSize=5

# Опционально: Cloudflare Worker для обращения к Telegram API без VPN
# TELEGRAM_API_URL=https://your-worker-name.your-subdomain.workers.dev

# Опционально: локальный прокси для Telegram API (например, http://127.0.0.1:3067)
# TELEGRAM_PROXY=http://127.0.0.1:3067


